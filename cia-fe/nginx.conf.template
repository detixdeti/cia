# ${PORT} and ${BACKEND_HOSTPORT} are filled in by the nginx image when the container starts.
server {
    listen ${PORT};

    root /usr/share/nginx/html;
    index index.html;

    # Password protection, written by basic-auth.sh (empty when no password is set)
    include /etc/nginx/basic-auth.conf;

    location /api/ {
        proxy_pass http://${BACKEND_HOSTPORT};
    }

    # Built files have a hash in their name, so they can be cached for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html is never cached, so a new build is visible after a normal reload.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
